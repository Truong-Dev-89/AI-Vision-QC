# Python virtual environment — each machine recreates it from requirements.txt
venv/
env/
__pycache__/
*.pyc

# Image data — usually heavy and can contain sensitive company data,
# should not go on git. Share via Drive/S3 separately as discussed.
data/raw/*/good/*
data/raw/*/suspect/*
data/raw/*/confirmed_ng/*
data/logs/

# Trained models — .pt files can be hundreds of MB, git isn't suited for large files
models/*/v*/

# Keep the folder structure (.gitkeep files) even though their contents are ignored
!**/.gitkeep

# OS files
.DS_Store
Thumbs.db

# API authentication key — never push this to git, each server generates its own
.api_key

# Personal/sensitive product configs (if they contain real internal IPs, PLC codes, etc.)
# Uncomment the lines below if you do NOT want to push real product configs to a shared repo
# configs/products/*.yaml
# !configs/products/_template.yaml
